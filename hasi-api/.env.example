# ---- Domain (DNS A record must point to the server) ----
API_DOMAIN=api.seudominio.com

# ---- PostgreSQL (internal Docker network only) ----
POSTGRES_DB=hasi
POSTGRES_USER=hasi
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- API ----
NODE_ENV=production
PORT=3000
# openssl rand -hex 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 bytes hex used for AES-256-GCM of BYOK keys: openssl rand -hex 32
# Keep a secure offline copy. Losing it makes saved keys unrecoverable.
BYOK_ENCRYPTION_KEY=
# Comma-separated origins allowed to call the API (admin panel URL)
CORS_ORIGINS=https://painel.seudominio.com
# Page in the admin panel that receives ?token=...
APP_RESET_URL=https://painel.seudominio.com/reset-password
TRUST_PROXY=true

# ---- SMTP for password recovery ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HASi <no-reply@seudominio.com>

# ---- Backups ----
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
